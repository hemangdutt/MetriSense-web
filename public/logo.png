<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#182029"/>
      <stop offset="70%" stop-color="#0E1319"/>
      <stop offset="100%" stop-color="#080C10"/>
    </radialGradient>
    
    <!-- Outer Glow / Rim -->
    <linearGradient id="rimGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3A4857"/>
      <stop offset="50%" stop-color="#1B242E"/>
      <stop offset="100%" stop-color="#0D1217"/>
    </linearGradient>

    <!-- Silver Metallic Gradient -->
    <linearGradient id="silverGrad" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="35%" stop-color="#DCE3EA"/>
      <stop offset="70%" stop-color="#9EABB7"/>
      <stop offset="100%" stop-color="#707E8C"/>
    </linearGradient>

    <!-- Steel Blue Metallic Gradient -->
    <linearGradient id="steelBlueGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#497298"/>
      <stop offset="50%" stop-color="#79A9D2"/>
      <stop offset="100%" stop-color="#A5C7E6"/>
    </linearGradient>

    <!-- Scale Pan Gradient -->
    <linearGradient id="panGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="30%" stop-color="#E2E7ED"/>
      <stop offset="85%" stop-color="#A6B3C0"/>
      <stop offset="100%" stop-color="#808F9E"/>
    </linearGradient>

    <!-- Scale Base Gradient -->
    <linearGradient id="baseGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#D1D8E0"/>
      <stop offset="25%" stop-color="#B0BDCB"/>
      <stop offset="80%" stop-color="#738292"/>
      <stop offset="100%" stop-color="#556372"/>
    </linearGradient>
    
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Squircle Base Container -->
  <rect x="24" y="24" width="464" height="464" rx="116" ry="116" fill="url(#bgGrad)" stroke="url(#rimGrad)" stroke-width="3"/>

  <!-- Dial Arc: Left Silver Section (approx 100 deg to 260 deg) -->
  <!-- Arc path from (150, 310) up to (245, 142) -->
  <path d="M 172 312 A 126 126 0 0 1 238 132" fill="none" stroke="url(#silverGrad)" stroke-width="22" stroke-linecap="round"/>

  <!-- Dial Arc: Top Indicator Vertical Gap & Notch -->
  <line x1="256" y1="130" x2="256" y2="148" stroke="url(#silverGrad)" stroke-width="12" stroke-linecap="round"/>

  <!-- Dial Arc: Upper Right Steel Blue Section -->
  <path d="M 274 132 A 126 126 0 0 1 366 238" fill="none" stroke="url(#steelBlueGrad)" stroke-width="22" stroke-linecap="round"/>

  <!-- Dial Arc: Lower Right Silver Segment -->
  <path d="M 364 266 A 126 126 0 0 1 340 312" fill="none" stroke="url(#silverGrad)" stroke-width="20" stroke-linecap="round"/>

  <!-- Dial Gauge Graduation Ticks -->
  <!-- Tick 1 -->
  <line x1="208" y1="206" x2="208" y2="222" stroke="#8E9DAE" stroke-width="6" stroke-linecap="round"/>
  <!-- Tick 2 -->
  <line x1="230" y1="192" x2="230" y2="222" stroke="#A7B6C5" stroke-width="6" stroke-linecap="round"/>
  <!-- Tick 3 (Center Indicator - Steel Blue) -->
  <line x1="256" y1="180" x2="256" y2="232" stroke="#79A9D2" stroke-width="8" stroke-linecap="round"/>
  <!-- Tick 4 -->
  <line x1="282" y1="192" x2="282" y2="222" stroke="#A7B6C5" stroke-width="6" stroke-linecap="round"/>
  <!-- Tick 5 -->
  <line x1="304" y1="206" x2="304" y2="222" stroke="#8E9DAE" stroke-width="6" stroke-linecap="round"/>

  <!-- Weighing Scale Upper Pan (Inverted Chamfered Trapezoid) -->
  <path d="M 190 242 L 322 242 L 306 266 L 206 266 Z" fill="url(#panGrad)"/>

  <!-- Load Cell Stem / Column -->
  <rect x="245" y="266" width="22" height="12" rx="2" fill="#808F9E"/>

  <!-- Weighing Scale Lower Chassis Base (Trapezoid) -->
  <path d="M 206 278 L 306 278 L 332 328 L 180 328 Z" fill="url(#baseGrad)"/>
  
  <!-- Subtle Pan highlight line -->
  <line x1="194" y1="244" x2="318" y2="244" stroke="#FFFFFF" stroke-opacity="0.6" stroke-width="2"/>
  <!-- Subtle Base bottom bevel shadow -->
  <line x1="184" y1="326" x2="328" y2="326" stroke="#333E4A" stroke-width="2"/>
</svg>
